# Python environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secrets
.env

# Datasets: contents are NOT committed (see data/README.md)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Exception: the team experiment's train/validation/test files ARE committed, so
# nobody has to run a script. The full combined file they're made from is not.
!data/processed/wildfire_drought/
data/processed/wildfire_drought/wildfire_drought.csv

# Trained models and metrics are NOT committed
models/*
!models/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store

# Future frontend
frontend/node_modules/
